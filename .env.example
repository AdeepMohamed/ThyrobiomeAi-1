# ============================================================
# ThyroBiomeAI — Environment Variables
# ============================================================

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/thyrobiome?sslmode=require"

# Authentication (Auth.js / NextAuth v5)
AUTH_SECRET="your-random-32-character-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# AI (xAI Grok API — server-side only, NEVER expose to frontend)
GROK_API_KEY="xai-your-grok-api-key"
GROK_MODEL="grok-3"

# File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_your_token_here"

# App
NEXT_PUBLIC_APP_NAME="ThyroBiomeAI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
